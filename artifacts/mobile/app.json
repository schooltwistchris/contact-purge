{
  "expo": {
    "name": "Contact Purge",
    "slug": "contactpurge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "contactpurge",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1E"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSContactsUsageDescription": "Contact Purge needs access to your contacts to find and remove ones you haven't been in touch with."
      },
      "bundleIdentifier": "com.contactpurge.app"
    },
    "android": {
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALL_LOG"
      ],
      "package": "com.contactpurge.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Contact Purge to access your contacts so you can find and remove ones you haven't spoken to in years."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/06230a8f-c7db-42cb-ae60-74843ea4336f"
    },
    "extra": {
      "eas": {
        "projectId": "06230a8f-c7db-42cb-ae60-74843ea4336f"
      }
    }
  }
}
