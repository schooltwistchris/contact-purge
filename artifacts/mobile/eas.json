{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "24.13.0",
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "EAS_NO_VCS": "1",
        "npm_config_frozen_lockfile": "false",
        "NPM_CONFIG_PRODUCTION": "false",
        "NODE_ENV": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "node": "24.13.0",
      "autoIncrement": true,
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
